class Solution {
public:
    vector<int> nextGreaterElement(vector<int>& nums1, vector<int>& nums2) {
        unordered_map<int,int> mp;
        stack<int> s;
        vector<int> ans;
        for(int num:nums2){
            while(!s.empty() && s.top()<num){
                mp[s.top()]=num;
                s.pop();
            }
            s.push(num);
        }
        for(int num:nums1){
            if(mp.count(num)){
                ans.push_back(mp[num]);
            }
            else{
                ans.push_back(-1);
            }
        }
        return ans;
    }
};
